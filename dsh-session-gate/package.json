{
  "name": "dsh-session-gate",
  "version": "0.1.0",
  "description": "Per-chat access for DeepSeek Harness: a composer button beside «Workspace Write» that opens a dialog to pick which MCP servers this chat's model may use and whether it may read images",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node scripts/host-test.mjs && node scripts/client-smoke.mjs",
    "test:host": "node scripts/host-test.mjs",
    "test:client": "node scripts/client-smoke.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "mcp",
    "tools",
    "images",
    "session"
  ],
  "license": "MIT"
}
