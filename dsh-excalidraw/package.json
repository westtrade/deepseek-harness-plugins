{
  "name": "dsh-excalidraw",
  "version": "0.1.0",
  "description": "A per-chat Excalidraw board for DeepSeek Harness: a right-sidebar tab with a shared canvas, plus agent tools to read it and draw on it",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "static",
    "scripts",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node scripts/host-test.mjs && node scripts/client-smoke.mjs",
    "test:host": "node scripts/host-test.mjs",
    "test:client": "node scripts/client-smoke.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test:board": "node scripts/board-smoke.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "MIT"
}
